# ==============================================================================
# SMART PERSONAL FINANCE DASHBOARD - BACKEND CONFIGURATION (.env.example)
# Copy this file to .env and customize for your local or production environment.
# NEVER commit real production secrets to version control.
# ==============================================================================

# Application Metadata
PROJECT_NAME="Smart Personal Finance API"
VERSION="1.0.0"
API_V1_STR="/api"

# Environment Mode: 'development' | 'production' | 'staging' | 'test'
ENVIRONMENT="development"

# Debug Mode: True for development (detailed logs), False for production
DEBUG=True

# Database Configuration
# Local SQLite (default for development):
DATABASE_URL="sqlite:///./finance.db"
# Production TiDB Cloud (MySQL-compatible with TLS/SSL):
# DATABASE_URL="mysql+pymysql://<user>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/<dbname>?ssl_verify_cert=true&ssl_verify_identity=true"

# Cross-Origin Resource Sharing (CORS) Allowed Origins
# Comma-separated list of allowed frontend origin URLs
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000"

# JWT Security Configuration
# Generate a 32+ character cryptographically secure key for production (e.g. `openssl rand -hex 32`)
SECRET_KEY="dev-secret-key-phase-2-1-smart-finance-backend-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Financial Assistant Configuration
# AI_PROVIDER: 'mock' (deterministic testing/offline) or 'gemini' (live Google Gemini)
AI_PROVIDER="mock"
AI_API_KEY="your-gemini-api-key-here"
AI_MODEL="gemini-2.5-flash"
MAX_HISTORY_MESSAGES=10
MAX_MESSAGE_LENGTH=1000
AI_TIMEOUT_SECONDS=30
